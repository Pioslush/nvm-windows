# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — SECRET, server-only. Used for the gate list, invite links,
# the seed script, and reminder emails.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ─────────────────────────────────────────────────────────────────────
# The public URL of the deployed app (no trailing slash). Used in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Optional in dev: without a key, emails are printed to the server console.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend.
EMAIL_FROM="GameDay Dock <dock@yourdomain.com>"

# ── Cron ────────────────────────────────────────────────────────────────────
# Any random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
