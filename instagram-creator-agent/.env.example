# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Instagram API (Meta app + Instagram Professional account)
IG_USER_ID=1784xxxxxxxxxxxxx          # Instagram professional account ID
IG_ACCESS_TOKEN=IGAA...               # long-lived access token
IG_GRAPH_HOST=graph.instagram.com     # or graph.facebook.com for the Facebook Login flavor
#IG_APP_SECRET=...                    # only needed for `exchange-token` (server-side only!)

# Optional: cross-post to a Facebook Page (set crosspost.facebook_page: true in config.yaml)
# `discover` prints both values when run with a Facebook-Login user token
#FB_PAGE_ID=...
#FB_PAGE_TOKEN=...                    # Page access token with pages_manage_posts

# Optional: cross-post to Threads (set crosspost.threads: true in config.yaml)
# Token needs threads_basic + threads_content_publish scopes
#THREADS_USER_ID=...
#THREADS_ACCESS_TOKEN=...

# Optional: re-host generated images on imgbb for stable permanent URLs
# (free key at https://api.imgbb.com/)
#IMGBB_API_KEY=...
